# Retrieva AI Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Application Settings
PROJECT_NAME="Retrieva AI"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# Logging
LOG_LEVEL="INFO"

# Dense Embeddings & Vector Storage (Phase 3)
CHROMA_PERSIST_DIRECTORY="./chroma_data"
CHROMA_COLLECTION_NAME="retrieva_documents"
BM25_MAX_CACHED_TENANTS=50
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# LLM Answer Generation & Evaluation (Phase 5)
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-flash-lite-latest"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=""
OPENAI_REQUEST_TIMEOUT=30.0
OPENAI_MAX_RETRIES=2
MAX_CONTEXT_TOKENS=2500
DEFAULT_TEMPERATURE=0.1
DEFAULT_MAX_COMPLETION_TOKENS=800

# Persistent Conversation & Chat Memory (Phase 7 Milestone 3)
CONVERSATION_DB_PATH="chroma_data/conversation_history.db"
CONVERSATION_HISTORY_WINDOW=5
QUERY_REWRITE_ENABLED=True
QUERY_REWRITE_TIMEOUT=10.0

# Supabase JWT Authentication & PostgREST Client (Phase 2/3 - publishable/anon key only, never service-role key)
SUPABASE_URL="https://zblfcosunplvnnwjfyjz.supabase.co"
SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_STORAGE_BUCKET="retrieva-user-documents"
# SUPABASE_JWKS_URL="https://zblfcosunplvnnwjfyjz.supabase.co/auth/v1/.well-known/jwks.json"
# SUPABASE_JWT_ISSUER="https://zblfcosunplvnnwjfyjz.supabase.co/auth/v1"
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_JWT_ALGORITHMS='["ES256", "RS256"]'
SUPABASE_JWKS_CACHE_TTL_SECONDS=300
SUPABASE_JWKS_TIMEOUT_SECONDS=5.0
SUPABASE_REST_TIMEOUT_SECONDS=10.0
BACKEND_RPC_HMAC_SECRET="replace-with-high-entropy-backend-rpc-hmac-secret"
AUTH_ENABLED=True

# Frontend Vite Supabase Authentication (Phase 3 Milestone 3.6 - public/anon key only, NEVER service-role)
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
VITE_SUPABASE_URL="https://zblfcosunplvnnwjfyjz.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
